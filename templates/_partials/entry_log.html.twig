{% if entries is empty %}
    <p class="entry-empty">Sin audios este día.</p>
{% else %}
    <div class="entry-log">
        {% for entry in entries %}
            <article class="entry">
                <div class="entry__time">
                    <svg class="icon icon--sm"><use href="#i-clock"></use></svg>
                    {{ entry.receivedAt|date('H:i', 'Europe/Madrid') }}
                </div>
                <div class="entry__body">
                    <div class="entry__meta">
                        <span class="duration">{{ entry.durationSeconds // 60 }}:{{ '%02d'|format(entry.durationSeconds % 60) }}</span>
                        {% if entry.status.value == 'TRANSCRIBED' %}
                            <span class="status-pill status-pill--transcribed"><svg class="icon"><use href="#i-check"></use></svg> Transcrito</span>
                        {% elseif entry.status.value == 'ERROR' %}
                            <span class="status-pill status-pill--error"><svg class="icon"><use href="#i-alert"></use></svg> Error</span>
                        {% else %}
                            <span class="status-pill status-pill--pending"><svg class="icon"><use href="#i-clock"></use></svg> Transcribiendo…</span>
                        {% endif %}
                    </div>

                    {% if entry.status.value == 'TRANSCRIBED' and entry.transcription %}
                        <p class="entry__text">{{ entry.transcription.content }}</p>
                    {% elseif entry.status.value == 'ERROR' %}
                        <div class="entry__error-box">
                            <svg class="icon"><use href="#i-error-outline"></use></svg>
                            <span>{{ entry.errorMessage }}</span>
                        </div>
                    {% else %}
                        <p class="entry__text entry__text--muted">Transcripción en curso — se actualizará automáticamente.</p>
                    {% endif %}

                    {% if entry.status.value in ['TRANSCRIBED', 'ERROR'] %}
                        <div class="entry__actions">
                            {% if entry.status.value == 'TRANSCRIBED' %}
                                <details class="entry__edit">
                                    <summary class="btn-action"><svg class="icon icon--sm"><use href="#i-edit"></use></svg> Editar</summary>
                                    <form class="entry__edit-form" method="post" action="{{ path('app_transcription_edit', {audioRecording: entry.id}) }}">
                                        <textarea name="transcription_edit[content]" rows="4">{{ entry.transcription.content }}</textarea>
                                        <input type="hidden" name="transcription_edit[_token]" value="{{ csrf_token('transcription_edit') }}">
                                        <button class="btn-action btn-action--primary" type="submit">Guardar</button>
                                    </form>
                                </details>
                            {% endif %}

                            {% if entry.status.value == 'ERROR' %}
                                <form method="post" action="{{ path('app_audio_recording_retry', {audioRecording: entry.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('audio_retry') }}">
                                    <button class="btn-action" type="submit"><svg class="icon icon--sm"><use href="#i-refresh"></use></svg> Reintentar</button>
                                </form>
                            {% endif %}

                            <form method="post" action="{{ path('app_transcription_delete', {audioRecording: entry.id}) }}" onsubmit="return confirm('¿Eliminar este audio y su transcripción? Esta acción no se puede deshacer.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('transcription_delete') }}">
                                <button class="btn-action btn-action--danger" type="submit"><svg class="icon icon--sm"><use href="#i-trash"></use></svg> Eliminar</button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
