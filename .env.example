# Copia este fichero a .env y ajusta los valores si hace falta:
#   cp .env.example .env

# --- Versiones de imagen (parametrizables por servicio) ---
PHP_VERSION=8.4
POSTGRES_VERSION=16
REDIS_VERSION=7
NGINX_VERSION=1.27

# --- Puertos publicados al host ---
# Único puerto expuesto del stack: diary-nginx (Symfony se sirve por aquí)
NGINX_HTTP_PORT=9008

# --- Rutas base de bind mounts (relativas a la raíz del repo) ---
LOGS_PATH=./logs
DATA_PATH=./data

# --- Credenciales de PostgreSQL (desarrollo local) ---
POSTGRES_DB=telegram_notes
POSTGRES_USER=telegram_notes
POSTGRES_PASSWORD=telegram_notes
