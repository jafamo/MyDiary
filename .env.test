# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Valores ficticios de Telegram: los tests no dependen del .env real (las llamadas HTTP van mockeadas)
TELEGRAM_BOT_TOKEN=test-bot-token
TELEGRAM_AUTHORIZED_CHAT_ID=123456789
TELEGRAM_WEBHOOK_TOKEN=test-webhook-token
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Proxy del dominio público: IP de documentación (TEST-NET-1) y URL ficticia, sin depender del .env real
KEENDNS_PROXY_IP=192.0.2.1
APP_PUBLIC_URL=https://diary.example.test

# Aviso "día sin audios": valores fijos, sin depender del .env real
IDLE_DAY_REMINDER_HOURS=15,17
IDLE_DAY_REMINDER_MESSAGE="Aviso de prueba: día sin audios"
